    if (summary) summary.style.display = 'none';
    var grid = document.getElementById('grid-page');
    if (grid) grid.style.display = 'none';
    document.querySelectorAll('.detail-view').forEach(function(el) { el.style.display = 'none'; });
    var targetId = 'ghost-' + name.replace(/[^a-zA-Z0-9_-]/g, '');
    var target = document.getElementById(targetId);
    if (target) target.style.display = 'block';
}

/** * SIDEBAR FILTERING 
 */
function filterList() {
    var filter = document.getElementById('searchInput').value.toLowerCase();
    var allItems = document.querySelectorAll('#sidebarList a');
    var showDeletedChecked = document.getElementById('showDeletedToggle').checked;

    allItems.forEach(function(item) {
        var name = item.getAttribute('data-name').toLowerCase();
        var isDeleted = item.classList.contains('is-deleted');
        var matchesSearch = name.indexOf(filter) > -1;
        
        if (isDeleted) {
            if (showDeletedChecked && matchesSearch) {
                item.classList.remove('collapsed-deleted');
            } else {
                item.classList.add('collapsed-deleted');
            }
        } else {
            item.style.display = matchesSearch ? "flex" : "none";
        }
    });
}

function toggleDeleted() { 
    filterList(); 
}

/** * ACCORDION LOGIC
 * Modified to allow multiple months but only one year.
 */
function handleAccordion(clickedElement, containerSelector) {
    var isOpen = clickedElement.open;
    
    // Years stay exclusive (one at a time)
    if (containerSelector === '.year-node') {
        var allSiblings = clickedElement.parentElement.querySelectorAll(containerSelector);
        if (!isOpen) {
            allSiblings.forEach(function(sib) {
                if (sib !== clickedElement && sib.open) {
                    sib.classList.add('collapsing');
                    setTimeout(function() { 
                        sib.open = false; 
                        sib.classList.remove('collapsing'); 
                    }, 400);
                }
            });
            clickedElement.open = true;
        } else {
            clickedElement.classList.add('collapsing');
            setTimeout(function() { 
                clickedElement.open = false; 
                clickedElement.classList.remove('collapsing'); 
            }, 400);
        }
    } else {
        // Months toggle independently (allow multiple)
        clickedElement.open = !isOpen;
    }
}

/** * ARCHIVE SEARCH & FILTERING 
 */
function handleSearchInput(e) {
    var input = document.getElementById('dockerArchiveSearch');
    var suggestions = document.getElementById('searchSuggestions');
    var clearBtn = document.getElementById('clearSearch');
    var val = input.value.toLowerCase();

    clearBtn.style.display = (val.length > 0) ? 'block' : 'none';

    if (val.length < 2) {
        suggestions.style.display = 'none';
        if (val.length === 0) clearArchiveSearch();
        return;
    }

    var names = new Set();
    if (typeof dockerHistory !== 'undefined') {
        dockerHistory.forEach(function(item) { if (item.container) names.add(item.container); });
    }
    document.querySelectorAll('#sidebarList a').forEach(function(a) {
        var n = a.getAttribute('data-name');
        if (n) names.add(n);
    });

    var matches = Array.from(names).filter(function(name) {
        return name.toLowerCase().indexOf(val) > -1;
    }).sort();

    if (matches.length > 0) {
        suggestions.innerHTML = '';
        matches.forEach(function(match) {
            var div = document.createElement('div');
            div.className = 'suggestion-item';
            div.innerText = match;
            div.onclick = function() { executeGlobalSearch(match); };
            suggestions.appendChild(div);
        });
        suggestions.style.display = 'block';
    } else {
        suggestions.style.display = 'none';
    }
}

function executeGlobalSearch(dockerName) {
    var input = document.getElementById('dockerArchiveSearch');
    var suggestions = document.getElementById('searchSuggestions');
    var status = document.getElementById('searchStatus');
    var tree = document.getElementById('tree-container');
    
    input.value = dockerName;
    suggestions.style.display = 'none';
    status.style.display = 'block';
    status.innerText = "Showing history for: " + dockerName;

    var foundSnapshots = new Set();
    if (typeof dockerHistory !== 'undefined') {
        dockerHistory.forEach(function(item) {
            if (item.container === dockerName) {
                var snapName = "docker_snapshot_" + item.sortID.toString().substring(0, 8);
                foundSnapshots.add(snapName);
            }
        });
    }

    tree.querySelectorAll('.day-chip').forEach(function(chip) {
        var href = chip.getAttribute('href');
        var snapFolder = href.split('/')[1];

        if (foundSnapshots.has(snapFolder)) {
            chip.style.display = 'flex'; // Centering fix
            chip.classList.add('active-search-match');
            chip.href = '../' + snapFolder + '/' + snapFolder + '.html?find=' + encodeURIComponent(dockerName);
        } else {
            chip.style.display = 'none';
        }
    });

    // Expand Years and all matching Months
    tree.querySelectorAll('.year-node').forEach(function(node) {
        var visibleChildren = node.querySelectorAll('.day-chip[style*="flex"]');
        node.style.display = visibleChildren.length > 0 ? 'block' : 'none';
        if (visibleChildren.length > 0) node.open = true;
    });

    tree.querySelectorAll('.month-node').forEach(function(node) {
        var visibleChildren = node.querySelectorAll('.day-chip[style*="flex"]');
        node.style.display = visibleChildren.length > 0 ? 'block' : 'none';
        if (visibleChildren.length > 0) node.open = true; // Open all matches
    });
}

function clearArchiveSearch() {
