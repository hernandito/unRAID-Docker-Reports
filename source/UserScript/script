#!/bin/bash
# ==================================
# Docker Active Templates Snapshot & Audit Dashboard
# ==================================
start_time=$SECONDS

# --- USER CONFIGURATION ---
# 	Path where reports and backups are stored. Strongly recommended you keep this folder, 
# 	otherwise you will need t manually edit the plugin's .plg file, and possibly ther files as well.
REPORTS_BASE="/mnt/user/appdata/reports/DockerReports"

# Windows/SMB path for the "Copy Path" feature (Update 'SERVERNAME' to your Unraid name)
WINDOWS_BASE="\\\\\\\\SERVERNAME\\\\appdata\\\\reports\\\\Docker Reports"

# Retention policy (How many days of history to keep)
KEEP_DAYS=3650

# Your Unraid WebGUI URL (Including Port if not 80)
UNRAID_URL="http://192.168.0.201:84/"

# Standard Unraid System Paths (Rarely need changing)
AUTOSTART_FILE="/var/lib/docker/unraid-autostart"

if [ -f "/boot/config/plugins/ca.update.applications/DockerUpdateSettings.json" ]; then
    AUTO_UPDATE_FILE="/boot/config/plugins/ca.update.applications/DockerUpdateSettings.json"
elif [ -f "/boot/config/plugins/community.applications/DockerUpdateSettings.json" ]; then
    AUTO_UPDATE_FILE="/boot/config/plugins/community.applications/DockerUpdateSettings.json"
else
    AUTO_UPDATE_FILE=""
fi

# --- INTERNAL PATHS & LOGIC ---
DATE=$(date +%Y%m%d)
FRIENDLY_DATE=$(date +%B" "%d", "%Y)
BACKUP_DIR="$REPORTS_BASE/docker_snapshot_$DATE"

declare -A DOCKER_ICONS
HUMAN_CHANGES=""
TRIGGER_FULL_BACKUP=false

# 1. CONSOLE LOG (Preserving your original HTML formatting)
echo ""
echo "<div style='width: 85%; border-radius: 4px; border: solid 1px #555; background: #555; padding: 8px;'><b><font color='#ffc926' size='3'>🐳 Docker Snapshot Backup</font></b></div>"
echo "<font color='#00698c'>Active containers only → $BACKUP_DIR</font>"
echo ""

# --- DYNAMIC HISTORY HELPER (Robust Sync) ---
log_to_history() {
    local container_name="$1"
    local change_type="$2"
    local change_details="$3"
    local icon_path="$4"
    local hist_json="$REPORTS_BASE/assets/docker_history.json"
    local hist_js="$REPORTS_BASE/assets/docker_history.js"
    
    [ ! -s "$hist_json" ] && echo "[]" > "$hist_json"
    
    local ts=$(date "+%B %d, %Y %I:%M %p")
    local sort_id=$(date "+%Y%m%d%H%M%S")
    local temp_json=$(mktemp)
    
    jq --arg c "$container_name" --arg t "$change_type" --arg d "$change_details" --arg i "$icon_path" --arg date "$ts" --argjson sid "$sort_id" '. + [{date: $date, sortID: $sid, container: $c, type: $t, details: $d, icon: $i}]' "$hist_json" > "$temp_json" && mv "$temp_json" "$hist_json"
    
    printf "const dockerHistory = " > "$hist_js"
    cat "$hist_json" >> "$hist_js"
    printf ";" >> "$hist_js"
    
    chmod 666 "$hist_json" "$hist_js"
    sync
    echo "&nbsp&nbsp📝 Ledger updated for: <font color='#00698c'><b>$container_name</b></font>"
}

# --- CLEANING HELPERS ---
# For the Summary Page (HTML)
clean_for_summary() {
    echo "$1" | sed 's/&#x279C;/ ➜ /g; s/&#xD;&#xA;/<br>/g; s/&#xD;/<br>/g; s/&#xA;/<br>/g; s/&amp;/\&/g; s/&quot;/\"/g; s/&#39;/\x27/g'
}

# For the Ledger Cards (JSON/JS)
clean_for_ledger() {
    echo "$1" | sed 's/&#x279C;/ ➜ /g; s/&#xD;&#xA;/\\n/g; s/&#xD;/\\n/g; s/&#xA;/\\n/g; s/&amp;/\&/g; s/&quot;/\"/g; s/&#39;/\x27/g'
}



DATE=$(date +%Y%m%d)
FRIENDLY_DATE=$(date +%B" "%d", "%Y)
BACKUP_DIR="$REPORTS_BASE/docker_snapshot_$DATE"

# Clean up temp files from previous runs to start fresh
rm -f "/tmp/snap_sidebar_$DATE.tmp" "/tmp/snap_grid_$DATE.tmp" "/tmp/snap_details_$DATE.tmp" "/tmp/snap_txt_$DATE.tmp" "/tmp/active_xmls_$DATE.txt"

# 1. CONSOLE LOG
echo ""
echo "<div style='width: 85%; border-radius: 4px; border: solid 1px #555; background: #555; padding: 8px;'><b><font color='#ffc926' size='3'>🐳 Docker Snapshot Backup</font></b></div>"
echo "<font color='#00698c'>Active containers only → $BACKUP_DIR</font>"
echo ""

CONTAINERS=$(docker ps -a --format "{{.Names}}" | sort -f)
NUM_CONTAINERS=$(echo "$CONTAINERS" | wc -l)
UNRAID_VER=$(grep version= /etc/unraid-version | cut -d'"' -f2 || echo "N/A")

if [ -n "$AUTO_UPDATE_FILE" ]; then
    AU_STATUS="<font color='#1f7900'>Found</font>"
else
    AU_STATUS="<font color='#b30000'>Missing</font>"
fi
echo "<b>🔍 System Checks:</b>"
echo "• AutoUpdate Config: $AU_STATUS" 
echo ""

echo "<b>🔍 Active containers (running + stopped):</b>"
echo "<font color='#1f7900'>$NUM_CONTAINERS containers found</font>"
echo ""

for c in $CONTAINERS; do
    ST=$(docker inspect -f '{{.State.Status}}' "$c" 2>/dev/null || echo "unknown")
    echo "🐳 $c ($ST)"
done

echo ""
echo "<b>📂 Backing up active templates...</b>"

# Build the TXT Report into a Temporary File
cat <<EOF > "/tmp/snap_txt_$DATE.tmp"
🐳 Docker Snapshot - $DATE
──────────────────────────────────────────────
Total Active Containers: $NUM_CONTAINERS
unRAID Version: $UNRAID_VER
Backup Location: $BACKUP_DIR/xml

Containers Not Running:
$(for c in $CONTAINERS; do
    st=$(docker inspect -f '{{.State.Status}}' "$c" 2>/dev/null || echo "unknown")
    [ "$st" != "running" ] && echo "• $c ($st)"
done)

Restore Instructions:
1. Stop Docker service (Settings → Docker → No → Apply)
2. Copy XML files to /boot/config/plugins/dockerMan/templates-user/
3. Restart Docker service (Yes → Apply)
4. In Docker tab: Add Container → select restored template from dropdown
──────────────────────────────────────────────
EOF

# --- START OF SMART LOGIC (DASHBOARD) ---
DASH_NOT_RUNNING_HTML=""
NON_RUNNING_DATA=$(docker ps -a --filter "status=exited" --filter "status=created" --filter "status=paused" --filter "status=dead" --format "{{.Names}} ({{.Status}})")

if [ -z "$NON_RUNNING_DATA" ]; then
    DASH_NOT_RUNNING_HTML="<li>All containers running</li>"
else
    while read -r line; do
        NAME=$(echo "$line" | cut -d' ' -f1)
        STATE=$(echo "$line" | grep -oP '\(\K[^ )]+' | head -1 | tr '[:upper:]' '[:lower:]')
        DASH_NOT_RUNNING_HTML+="<li>$NAME ($STATE)</li>"
    done <<< "$NON_RUNNING_DATA"
fi

# --- SMART FOLDER SELECTION (FIXED) ---
# We ONLY consider today a valid backup baseline if the xml folder was successfully created
if [ -d "$BACKUP_DIR/xml" ]; then
    LAST_BACKUP="$BACKUP_DIR"
    echo "Comparing against today's existing snapshot..."
else
    LAST_BACKUP=$(find "$REPORTS_BASE" -maxdepth 1 -type d -name "docker_snapshot_*" ! -name "docker_snapshot_$DATE" | sort | tail -n 1)
    echo "No snapshot today yet. Comparing against: $(basename "$LAST_BACKUP")"
    
    # If no folder exists at all, force backup
    if [ -z "$LAST_BACKUP" ]; then TRIGGER_FULL_BACKUP=true; fi
fi

# Ensure JS bridge is synced at start of every run
HISTORY_FILE="$REPORTS_BASE/assets/docker_history.json"
[ ! -f "$HISTORY_FILE" ] && echo "[]" > "$HISTORY_FILE"

if [ -f "$HISTORY_FILE" ]; then
    printf "const dockerHistory = " > "$REPORTS_BASE/assets/docker_history.js"
    cat "$HISTORY_FILE" >> "$REPORTS_BASE/assets/docker_history.js"
    printf ";" >> "$REPORTS_BASE/assets/docker_history.js"
    chmod 666 "$REPORTS_BASE/assets/docker_history.js"
fi

# 4. PROCESSING LOOP
COPIED=0
NOT_RUNNING_HTML=""
OFFLINE_ICONS_HTML=""






for container in $CONTAINERS; do
    # --- 1. INITIALIZE & CAPTURE METADATA FIRST ---
    CURRENT_DOCKER_CHANGES=""
    SCAN_LEDGER_ENTRIES=""   # Buffer for the JSON Ledger
    SCAN_SUMMARY_ENTRIES=""  # Buffer for the HTML Summary Page
    
    norm=$(echo "$container" | tr '[:upper:]' '[:lower:]' | sed 's/ /-/g; s/_/-/g; s/--*/-/g; s/^-//; s/-$//')
    XML_FILE=""
    for try in "$norm" "my-$norm" "${norm//-/_}" "my-${norm//-/_}" "${container,,}" "my-${container,,}"; do
        candidate=$(find /boot/config/plugins/dockerMan/templates-user -type f -iname "*$try*.xml" -print -quit 2>/dev/null)
        [ -n "$candidate" ] && XML_FILE="$candidate" && break
    done

    if [ -z "$XML_FILE" ]; then continue; fi
    
    FILE_NAME=$(basename "$XML_FILE")
    echo "$XML_FILE" >> "/tmp/active_xmls_$DATE.txt"
    
    # Smart Folder Selection
    LAST_XML="$LAST_BACKUP/xml/$FILE_NAME"
    XML_BASE64=$(base64 -w 0 "$XML_FILE")
    ((COPIED++))
    
    # Capture XML Fields
    NAME=$(sed -n 's/.*<Name>\(.*\)<\/Name>.*/\1/p' "$XML_FILE" | head -1)
    REPO=$(sed -n 's/.*<Repository>\(.*\)<\/Repository>.*/\1/p' "$XML_FILE")
    ICON=$(sed -n 's/.*<Icon>\(.*\)<\/Icon>.*/\1/p' "$XML_FILE")
    NETWORK=$(sed -n 's/.*<Network>\(.*\)<\/Network>.*/\1/p' "$XML_FILE")
    NET_TYPE=$(sed -n 's/.*<NetworkType>\(.*\)<\/NetworkType>.*/\1/p' "$XML_FILE")
    USE_TS=$(sed -n 's/.*<Tailscale>\(.*\)<\/Tailscale>.*/\1/p' "$XML_FILE")
    SHELL_CMD=$(sed -n 's/.*<Shell>\(.*\)<\/Shell>.*/\1/p' "$XML_FILE")
    EXTRA_PARAMS=$(sed -n 's/.*<ExtraParams>\(.*\)<\/ExtraParams>.*/\1/p' "$XML_FILE")
    POST_ARGS=$(sed -n 's/.*<PostArgs>\(.*\)<\/PostArgs>.*/\1/p' "$XML_FILE")
    
	# Multi-line grab for Overview & Notes (Now formatting carriage returns into real line breaks!)
    OVERVIEW=$(grep -ozP '(?s)<Overview>\K.*?(?=</Overview>)' "$XML_FILE" | tr -d '\0' | sed 's/&amp;/\&/g; s/&lt;/</g; s/&gt;/>/g; s/&quot;/\"/g; s/&#39;/\x27/g; s/&#xD;&#xA;/\n/g; s/&#xD;/\n/g; s/&#xA;/\n/g')
    NOTES=$(grep -ozP '(?s)<Notes>\K.*?(?=</Notes>)' "$XML_FILE" | tr -d '\0' | sed 's/&amp;/\&/g; s/&lt;/</g; s/&gt;/>/g; s/&quot;/\"/g; s/&#39;/\x27/g; s/&#xD;&#xA;/\n/g; s/&#xD;/\n/g; s/&#xA;/\n/g')
    
    WEBUI=$(sed -n 's/.*<WebUI>\(.*\)<\/WebUI>.*/\1/p' "$XML_FILE" | sed -E 's/\[PORT:([0-9]+)\]/\1/g')
    CONFIG_PATH=$(sed -n '/Target="\/config"/s/.*>\([^<]*\)<.*/\1/p' "$XML_FILE" | xargs)
    STATUS=$(docker inspect -f '{{.State.Status}}' "$container" 2>/dev/null || echo "unknown")
    DOCKER_ICONS["$NAME"]="$ICON"

    # --- 2. RUN SENSORS & ACCUMULATE LOGS ---

    # SENSOR 1: AUTOSTART
    [ -f "$AUTOSTART_FILE" ] && grep -Fxq "$container" "$AUTOSTART_FILE" && IS_AUTO="Enabled" || IS_AUTO="Disabled"
    if [ -n "$LAST_BACKUP" ] && [ -f "$LAST_BACKUP/autostart.list" ]; then
        grep -Fxq "$container" "$LAST_BACKUP/autostart.list" && WAS_AUTO="Enabled" || WAS_AUTO="Disabled"
        if [ "$WAS_AUTO" != "$IS_AUTO" ]; then
            TRIGGER_FULL_BACKUP=true
            SCAN_LEDGER_ENTRIES+="<li><span class='ledger-pill label-autostart'>AutoStart</span> <span class='ledger-text'>updated</span> <div class='ledger-value-change'><span class='change-old'>$WAS_AUTO</span> <span class='change-arrow'>&#10142;</span> <span class='change-new'>$IS_AUTO</span></div></li>"
            SCAN_SUMMARY_ENTRIES+="<li><span class='summary-pill sum-label-autostart'>AutoStart</span> <span class='sum-text'>updated</span> <div class='summary-value-change'><span class='sum-old'>$WAS_AUTO</span> <span class='sum-arrow'>&#10142;</span> <span class='sum-new'>$IS_AUTO</span></div></li>"
        fi
    fi

    # SENSOR 2: AUTOUPDATE
    if [ -n "$AUTO_UPDATE_FILE" ]; then
        IS_UP=$(jq -r ".containers[\"$container\"].update" "$AUTO_UPDATE_FILE" 2>/dev/null)
        [ "$IS_UP" == "true" ] && IS_AUTO_UP="Enabled" && echo "$container" >> "/tmp/current_autoupdate_enabled_$DATE.txt" || IS_AUTO_UP="Disabled"
        if [ -n "$LAST_BACKUP" ] && [ -f "$LAST_BACKUP/autoupdate.list" ]; then
            grep -Fxq "$container" "$LAST_BACKUP/autoupdate.list" && WAS_UP="Enabled" || WAS_UP="Disabled"
            if [ "$WAS_UP" != "$IS_AUTO_UP" ]; then
                TRIGGER_FULL_BACKUP=true
                SCAN_LEDGER_ENTRIES+="<li><span class='ledger-pill label-autoupdate'>AutoUpdate</span> <span class='ledger-text'>updated</span> <div class='ledger-value-change'><span class='change-old'>$WAS_UP</span> <span class='change-arrow'>&#10142;</span> <span class='change-new'>$IS_AUTO_UP</span></div></li>"
                SCAN_SUMMARY_ENTRIES+="<li><span class='summary-pill sum-label-autoupdate'>AutoUpdate</span> <span class='sum-text'>updated</span> <div class='summary-value-change'><span class='sum-old'>$WAS_UP</span> <span class='sum-arrow'>&#10142;</span> <span class='sum-new'>$IS_AUTO_UP</span></div></li>"
            fi
        fi
    fi

	# SENSOR 2.5: NEW CONTAINER DETECTION
    if [ -n "$LAST_BACKUP" ] && [ ! -f "$LAST_XML" ]; then
        # Check if we already logged this addition today
        if ! grep -Fxq "$NAME" "/tmp/added_dockers_$DATE.txt" 2>/dev/null; then
            echo "$NAME" >> "/tmp/added_dockers_$DATE.txt"
            TRIGGER_FULL_BACKUP=true
            SCAN_LEDGER_ENTRIES+="<li><span class='ledger-pill label-added'>Added</span> <span class='ledger-text'>container</span> <div class='ledger-value-change'><span class='change-new'>Installed</span></div></li>"
            SCAN_SUMMARY_ENTRIES+="<li><span class='summary-pill sum-label-added'>Added</span> <span class='sum-text'>container</span> <div class='summary-value-change'><span class='sum-new'>Installed</span></div></li>"
        fi
    fi



# SENSOR 3: CONFIG AUDIT
    if [ -n "$LAST_BACKUP" ] && [ -f "$LAST_XML" ]; then
        source "$REPORTS_BASE/assets/audit_logic.sh"
        DIFF_DATA=$(compare_configs "$container" "$XML_FILE" "$LAST_XML")
        if [ -n "$DIFF_DATA" ]; then
            TRIGGER_FULL_BACKUP=true
            unset OLD_VALS NEW_VALS TAG_MAP CTX_MAP
            declare -A OLD_VALS; declare -A NEW_VALS; declare -A TAG_MAP; declare -A CTX_MAP
            while read -r line; do
                [ -z "$line" ] && continue
                PREFIX="${line:0:1}"; RAW_LINE="${line#? }"
                safe_line=$(echo "$RAW_LINE" | sed 's/&/\&amp;/g; s/</\&lt;/g; s/>/\&gt;/g')
                RAW_LABEL=$(echo "$RAW_LINE" | cut -d':' -f1)
                MAIN_TAG=$(echo "$RAW_LABEL" | awk '{print $1}')
                CONTEXT=$(echo "$RAW_LABEL" | cut -d' ' -f2- | tr -d '()')
                VAL_ONLY=$(echo "${safe_line#*: }")
                [[ "$MAIN_TAG" == "()" ]] || [[ -z "$CONTEXT" ]] && continue
                KEY="${MAIN_TAG}_${CONTEXT}"; KEY="${KEY// /_}" 
                TAG_MAP["$KEY"]="$MAIN_TAG"; CTX_MAP["$KEY"]="$CONTEXT"
                
                if [[ "$line" == "< "* ]]; then OLD_VALS["$KEY"]="$VAL_ONLY"; elif [[ "$line" == "> "* ]]; then NEW_VALS["$KEY"]="$VAL_ONLY"; fi
            done <<< "$DIFF_DATA"

            for KEY in "${!TAG_MAP[@]}"; do
                M_TAG="${TAG_MAP[$KEY]}"; CTX="${CTX_MAP[$KEY]}"; OLD="${OLD_VALS[$KEY]}"; NEW="${NEW_VALS[$KEY]}"
                
				# --- SANITIZE FOR LEDGER & SUMMARY ---
                # We double-escape to prevent breakage from quotes or brackets
                L_OLD=$(clean_for_ledger "$OLD" | sed 's/"/\&quot;/g; s/</\&lt;/g; s/>/\&gt;/g')
                L_NEW=$(clean_for_ledger "$NEW" | sed 's/"/\&quot;/g; s/</\&lt;/g; s/>/\&gt;/g')
                
                S_OLD=$(clean_for_summary "$OLD" | sed 's/"/\&quot;/g; s/</\&lt;/g; s/>/\&gt;/g')
                S_NEW=$(clean_for_summary "$NEW" | sed 's/"/\&quot;/g; s/</\&lt;/g; s/>/\&gt;/g')
                
                TARGET_VAL=$(sed -n "/Name=\"$CTX\"/s/.*Target=\"\([^\"]*\)\".*/\1/p" "$XML_FILE" | head -1)
                [ -z "$TARGET_VAL" ] && TARGET_VAL=$(sed -n "/Name=\"$CTX\"/s/.*Target=\"\([^\"]*\)\".*/\1/p" "$LAST_XML" | head -1)
                
                if [ -n "$TARGET_VAL" ]; then
                    if [[ "$M_TAG" == "Variable" ]]; then
                        LEDGER_CTX="$CTX <span class='ledger-key'>($TARGET_VAL)</span>"
                        SUM_CTX="$CTX <span class='sum-key'>($TARGET_VAL)</span>"
                    elif [[ "$M_TAG" == "Port" ]]; then
                        LEDGER_CTX="$CTX <span class='ledger-key'>(Internal: $TARGET_VAL)</span>"
                        SUM_CTX="$CTX <span class='sum-key'>(Internal: $TARGET_VAL)</span>"
                    elif [[ "$M_TAG" == "Path" ]]; then
                        LEDGER_CTX="$CTX <span class='ledger-key'>(Container Path: $TARGET_VAL)</span>"
                        SUM_CTX="$CTX <span class='sum-key'>(Container Path: $TARGET_VAL)</span>"
                    fi
                else
                    LEDGER_CTX="$CTX"; SUM_CTX="$CTX"
                fi
                
                if [ -n "$OLD" ] && [ -n "$NEW" ]; then
                    SCAN_LEDGER_ENTRIES+="<li><span class='ledger-pill label-changed'>${M_TAG}</span> <span class='ledger-text'>updated</span> <span class='ledger-name'>${LEDGER_CTX}</span> <div class='ledger-value-change'><span class='change-old'>$L_OLD</span> <span class='change-arrow'>&#10142;</span> <span class='change-new'>$L_NEW</span></div></li>"
                    SCAN_SUMMARY_ENTRIES+="<li><span class='summary-pill sum-label-changed'>${M_TAG}</span> <span class='sum-text'>updated</span> <span class='sum-name'>${SUM_CTX}</span> <div class='summary-value-change'><span class='sum-old'>$S_OLD</span> <span class='sum-arrow'>&#10142;</span> <span class='sum-new'>$S_NEW</span></div></li>"
                elif [ -n "$OLD" ]; then
                    SCAN_LEDGER_ENTRIES+="<li><span class='ledger-pill label-removed'>Removed ${M_TAG}</span> <span class='ledger-name'>${LEDGER_CTX}</span> <div class='ledger-value-change'><span class='change-old'>$L_OLD</span></div></li>"
                    SCAN_SUMMARY_ENTRIES+="<li><span class='summary-pill sum-label-removed'>Removed ${M_TAG}</span> <span class='sum-name'>${SUM_CTX}</span> <div class='summary-value-change'><span class='sum-old'>$S_OLD</span></div></li>"
                elif [ -n "$NEW" ]; then
                    SCAN_LEDGER_ENTRIES+="<li><span class='ledger-pill label-added'>Added ${M_TAG}</span> <span class='ledger-name'>${LEDGER_CTX}</span> <div class='ledger-value-change'><span class='change-new'>$L_NEW</span></div></li>"
                    SCAN_SUMMARY_ENTRIES+="<li><span class='summary-pill sum-label-added'>Added ${M_TAG}</span> <span class='sum-name'>${SUM_CTX}</span> <div class='summary-value-change'><span class='sum-new'>$S_NEW</span></div></li>"
                fi
            done
        fi
    fi


	# SENSOR 4: TOTAL AWARENESS
    if [ -n "$LAST_BACKUP" ] && [ -f "$LAST_XML" ]; then
        OLD_EP=$(sed -n 's/.*<ExtraParams>\(.*\)<\/ExtraParams>.*/\1/p' "$LAST_XML")
        OLD_PA=$(sed -n 's/.*<PostArgs>\(.*\)<\/PostArgs>.*/\1/p' "$LAST_XML")
        OLD_NET_NAME=$(sed -n 's/.*<Network>\(.*\)<\/Network>.*/\1/p' "$LAST_XML")
        OLD_NET_TYPE=$(sed -n 's/.*<NetworkType>\(.*\)<\/NetworkType>.*/\1/p' "$LAST_XML")
        
        if [ "$OLD_EP" != "$EXTRA_PARAMS" ]; then
            TRIGGER_FULL_BACKUP=true
            # Sanitize and escape dangerous characters (brackets and quotes)
            L_OLD_EP=$(clean_for_ledger "$OLD_EP" | sed 's/"/\&quot;/g; s/</\&lt;/g; s/>/\&gt;/g')
            L_NEW_EP=$(clean_for_ledger "$EXTRA_PARAMS" | sed 's/"/\&quot;/g; s/</\&lt;/g; s/>/\&gt;/g')
            S_OLD_EP=$(clean_for_summary "$OLD_EP" | sed 's/"/\&quot;/g; s/</\&lt;/g; s/>/\&gt;/g')
            S_NEW_EP=$(clean_for_summary "$EXTRA_PARAMS" | sed 's/"/\&quot;/g; s/</\&lt;/g; s/>/\&gt;/g')
            
            SCAN_LEDGER_ENTRIES+="<li><span class='ledger-pill label-changed'>ExtraParams</span> <span class='ledger-text'>updated</span> <div class='ledger-value-change'><span class='change-old'>${L_OLD_EP:-None}</span> <span class='change-arrow'>&#10142;</span> <span class='change-new'>${L_NEW_EP:-None}</span></div></li>"
            SCAN_SUMMARY_ENTRIES+="<li><span class='summary-pill sum-label-changed'>ExtraParams</span> <span class='summary-text'>updated</span> <div class='summary-value-change'><span class='sum-old'>${S_OLD_EP:-None}</span> <span class='sum-arrow'>&#10142;</span> <span class='sum-new'>${S_NEW_EP:-None}</span></div></li>"
        fi

        if [ "$OLD_PA" != "$POST_ARGS" ]; then
            TRIGGER_FULL_BACKUP=true
            # Sanitize and escape dangerous characters (brackets and quotes)
            L_OLD_PA=$(clean_for_ledger "$OLD_PA" | sed 's/"/\&quot;/g; s/</\&lt;/g; s/>/\&gt;/g')
            L_NEW_PA=$(clean_for_ledger "$POST_ARGS" | sed 's/"/\&quot;/g; s/</\&lt;/g; s/>/\&gt;/g')
            S_OLD_PA=$(clean_for_summary "$OLD_PA" | sed 's/"/\&quot;/g; s/</\&lt;/g; s/>/\&gt;/g')
            S_NEW_PA=$(clean_for_summary "$POST_ARGS" | sed 's/"/\&quot;/g; s/</\&lt;/g; s/>/\&gt;/g')
            
            SCAN_LEDGER_ENTRIES+="<li><span class='ledger-pill label-changed'>PostArgs</span> <span class='ledger-text'>updated</span> <div class='ledger-value-change'><span class='change-old'>${L_OLD_PA:-None}</span> <span class='change-arrow'>&#10142;</span> <span class='change-new'>${L_NEW_PA:-None}</span></div></li>"
            SCAN_SUMMARY_ENTRIES+="<li><span class='summary-pill sum-label-changed'>PostArgs</span> <span class='summary-text'>updated</span> <div class='summary-value-change'><span class='sum-old'>${S_OLD_PA:-None}</span> <span class='sum-arrow'>&#10142;</span> <span class='sum-new'>${S_NEW_PA:-None}</span></div></li>"
        fi

        # Network change (Simple text, usually safe but adding basic N/A protection)
        if [ "$OLD_NET_TYPE" != "$NET_TYPE" ] || [ "$OLD_NET_NAME" != "$NETWORK" ]; then
             TRIGGER_FULL_BACKUP=true
             SCAN_LEDGER_ENTRIES+="<li><span class='ledger-pill label-changed'>Network</span> <span class='ledger-text'>changed</span> <div class='ledger-value-change'><span class='change-old'>${OLD_NET_NAME:-N/A} (${OLD_NET_TYPE:-N/A})</span> <span class='change-arrow'>&#10142;</span> <span class='change-new'>$NETWORK ($NET_TYPE)</span></div></li>"
             SCAN_SUMMARY_ENTRIES+="<li><span class='summary-pill sum-label-changed'>Network</span> <span class='summary-text'>changed</span> <div class='summary-value-change'><span class='sum-old'>${OLD_NET_NAME:-N/A} (${OLD_NET_TYPE:-N/A})</span> <span class='sum-arrow'>&#10142;</span> <span class='sum-new'>$NETWORK ($NET_TYPE)</span></div></li>"
        fi
