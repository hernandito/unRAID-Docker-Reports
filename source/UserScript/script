/** * BUILD ARCHIVE TREE 
 */
function buildTree() {
    var container = document.getElementById('tree-container');
    if (!container || typeof allSnapshots === 'undefined') return;
    
    var urlParams = new URLSearchParams(window.location.search);
    var currentFind = urlParams.get('find');

    var treeData = {};
    allSnapshots.forEach(function(snap) {
        var y = snap.substring(16, 20), m = snap.substring(20, 22);
        if (!treeData[y]) treeData[y] = {};
        if (!treeData[y][m]) treeData[y][m] = [];
        treeData[y][m].push(snap);
    });

    container.innerHTML = '';
    var curY = currentReportDate.substring(0, 4);
    var curM = currentReportDate.substring(4, 6);

    Object.keys(treeData).sort(function(a, b) { return b - a; }).forEach(function(year) {
        var yearDet = document.createElement('details');
        yearDet.className = 'year-node';
        yearDet.open = (year === curY);
        var yearSum = document.createElement('summary');
        yearSum.innerHTML = '<span>' + year + '</span>';
        yearSum.onclick = function(e) { e.preventDefault(); handleAccordion(yearDet, '.year-node'); };
        
        var yearContent = document.createElement('div');
        Object.keys(treeData[year]).sort(function(a, b) { return b - a; }).forEach(function(month) {
            var mNames = ["January","February","March","April","May","June","July","August","September","October","November","December"];
            var monthDet = document.createElement('details');
            monthDet.className = 'month-node';
            monthDet.open = (year === curY && month === curM);
            var monthSum = document.createElement('summary');
            monthSum.innerText = mNames[parseInt(month)-1];
            monthSum.onclick = function(e) { e.preventDefault(); handleAccordion(monthDet, '.month-node'); };
            
            var widgetContent = document.createElement('div');
            var widgetHeader = document.createElement('div');
            widgetHeader.className = 'month-header-widget';
            widgetHeader.innerHTML = '<span>' + mNames[parseInt(month)-1] + '<span class="year-text">' + year + '</span></span><span>▼</span>';
            widgetHeader.onclick = function(e) { e.stopPropagation(); handleAccordion(monthDet, '.month-node'); };
            
            var grid = document.createElement('div');
            grid.className = 'day-grid';
            treeData[year][month].sort(function(a, b) { return parseInt(a.substring(22, 24)) - parseInt(b.substring(22, 24)); }).forEach(function(snap) {
                var dString = snap.substring(16);
                var day = parseInt(dString.substring(6, 8), 10);
                var a = document.createElement('a');
                a.className = 'day-chip' + (dString === currentReportDate ? ' active-day' : '');
                
                if (currentFind) {
                    a.href = '../' + snap + '/' + snap + '.html?find=' + encodeURIComponent(currentFind);
                } else {
                    a.href = '../' + snap + '/' + snap + '.html';
                }
                
                a.innerText = day;
                grid.appendChild(a);
            });
            
            widgetContent.appendChild(widgetHeader);
            widgetContent.appendChild(grid);
            monthDet.appendChild(monthSum);
            monthDet.appendChild(widgetContent);
            yearContent.appendChild(monthDet);
        });
        yearDet.appendChild(yearSum);
        yearDet.appendChild(yearContent);
        container.appendChild(yearDet);
    });
}

/** * LEDGER & MISC UTILS 
 */
function renderLedger() {
    if (typeof dockerHistory === 'undefined') return;
    var reportLimit = parseInt(currentReportDate + "235959");
    document.querySelectorAll('[data-ledger-for]').forEach(function(container) {
        var cName = container.getAttribute('data-ledger-for');
        var cData = dockerHistory.filter(function(item) { return item.container === cName; }).sort(function(a, b) { return (b.sortID || 0) - (a.sortID || 0); });
        var html = '<div class="history-title">Activity Ledger</div>';
        if (cData.length === 0) {
            html += '<div style="color:#999; font-style:italic; font-size:12px; padding:15px; text-align:center;">No history found.</div>';
        } else {
            var futureCardsEncountered = false;
            var barrierShown = false;
            cData.forEach(function(item) {
                var itemSortID = item.sortID || 0;
                var isFuture = itemSortID > reportLimit;
                if (isFuture) futureCardsEncountered = true;
                if (!isFuture && futureCardsEncountered && !barrierShown) {
                    html += '<div class="ledger-time-barrier"><span>🠉 Future Changes 🠉</span></div>';
                    barrierShown = true;
                }
                var cardClass = isFuture ? ' ledger-card-future' : '';
                html += '<div class="ledger-card' + cardClass + '"><div class="ledger-header"><span class="ledger-type-pill type-' + item.type.split(" ")[0].toLowerCase() + '">' + item.type + '</span><span class="ledger-date">' + item.date + '</span></div><div class="ledger-details"><ul>' + item.details + '</ul></div></div>';
            });
        }
        container.innerHTML = html;
    });
}

function buildDeletedList() {
    if (typeof dockerHistory === 'undefined') return;
    var sidebarList = document.getElementById('sidebarList');
    var activeNodes = Array.prototype.slice.call(sidebarList.querySelectorAll('a'));
    var activeNames = new Set(activeNodes.map(function(a) { return a.getAttribute('data-name'); }));
    var historyNames = new Set(dockerHistory.map(function(item) { return item.container; }));
    var deletedNames = Array.from(historyNames).filter(function(name) { return !activeNames.has(name); });
    var mainContent = document.querySelector('.main');
    var allNodes = activeNodes.slice();

    deletedNames.forEach(function(name) {
        var cData = dockerHistory.filter(function(item) { return item.container === name; }).sort(function(a, b) { return (b.sortID || 0) - (a.sortID || 0); });
        var lastEntry = cData[0];
        var dateStr = lastEntry && lastEntry.date ? lastEntry.date.split(' ').slice(0, 3).join(' ') : "Unknown";
        var icon = lastEntry ? lastEntry.icon : 'https://via.placeholder.com/28?text=?';
        var safeHTMLName = name.replace(/"/g, '&quot;');
        
        var a = document.createElement('a');
        a.className = 'deleted-item is-deleted collapsed-deleted';
        a.setAttribute('data-name', name);
        a.onclick = function() { showDeleted(name); };
        a.innerHTML = '<img src="' + icon + '"> <div style="display:flex; flex-direction:column;"><span>' + name + '</span><span class="deleted-date">Deleted: ' + dateStr + '</span></div>';
        allNodes.push(a);

        var ghostId = 'ghost-' + name.replace(/[^a-zA-Z0-9_-]/g, '');
        var ghostCard = document.createElement('div');
        ghostCard.id = ghostId;
        ghostCard.className = 'container detail-view ghost-view';
        ghostCard.style.display = 'none';
        ghostCard.innerHTML = '<div class="dd-split-container"><div class="dd-details-left"><div class="detail-header-wrapper detail-header-ghost"><div class="detail-header-left"><img src="' + icon + '"><h2>' + name + ' <span class="badge-deleted">⚠️ This Docker has been DELETED! </span></h2></div></div><div class="offline-state"><p>This container is no longer installed.</p><p style="color:#999; font-size:12px;">Historical settings are safely archived.</p><button class="config-load-btn" onclick="loadHistoricalConfig(\'' + safeHTMLName + '\', this)">📥 Load Last Known Config</button></div></div><div class="dd-history-right"><div data-ledger-for="' + safeHTMLName + '"></div></div></div>';
        mainContent.appendChild(ghostCard);
    });

    allNodes.sort(function(a, b) { return a.getAttribute('data-name').toLowerCase().localeCompare(b.getAttribute('data-name').toLowerCase()); });
    sidebarList.innerHTML = '';
    allNodes.forEach(function(node) { sidebarList.appendChild(node); });
}

async function loadHistoricalConfig(containerName, btnElement) {
    btnElement.innerText = "Searching Archives...";
    btnElement.disabled = true;
    var xmlText = null, foundSnap = null, finalFileName = null;
    var snaps = typeof allSnapshots !== 'undefined' ? allSnapshots.slice().sort().reverse() : [];
    var currentUrl = window.location.href;
    var baseUrl = currentUrl.substring(0, currentUrl.lastIndexOf('/'));
    var pluginDataRoot = baseUrl.substring(0, baseUrl.lastIndexOf('/'));
    var variations = [containerName + '.xml', 'my-' + containerName + '.xml'];

    for (var i = 0; i < snaps.length; i++) {
        var snap = snaps[i];
        if (snap.indexOf(currentReportDate) > -1) continue;
        for (var j = 0; j < variations.length; j++) {
            var fileVariation = variations[j];
            var fetchUrl = pluginDataRoot + '/' + snap + '/xml/' + fileVariation;
            try {
                var response = await fetch(fetchUrl);
                if (response.ok) {
                    xmlText = await response.text();
                    foundSnap = snap; finalFileName = fileVariation;
                    break; 
                }
            } catch (e) { console.error("Fetch error", e); }
        }
        if (xmlText) break;
    }
    
    if (!xmlText) {
        alert("Search Failed.\nChecked: " + variations.join(', '));
        btnElement.innerText = "❌ Not Found";
        setTimeout(function() { btnElement.innerText = "📥 Load Last Known Config"; btnElement.disabled = false; }, 3000);
        return;
    }

    var parser = new DOMParser();
    var xmlDoc = parser.parseFromString(xmlText, "text/xml");
    var getTagText = function(tag) { var el = xmlDoc.getElementsByTagName(tag)[0]; return el ? el.textContent : 'N/A'; };

    var ports = '', envs = '', vols = '';
    var configs = xmlDoc.getElementsByTagName('Config');
    for(var k=0; k < configs.length; k++) {
        var c = configs[k], type = c.getAttribute('Type'), cName = c.getAttribute('Name') || 'Unknown', target = c.getAttribute('Target') || 'N/A', value = c.textContent || c.getAttribute('Default') || 'N/A';
        if (type === 'Port') ports += "• " + cName + " (" + target + "): " + value + "\n";
        if (type === 'Variable') envs += "• " + cName + " (" + target + "): " + value + "\n";
        if (type === 'Path') vols += "• " + cName + " (" + target + "): " + value + "\n";
    }

    var displayDate = foundSnap.replace('docker_snapshot_', '').replace(/(\d{4})(\d{2})(\d{2})/, '$1-$2-$3');
    var detailsContainer = btnElement.closest('.dd-details-left');
    
    var newHTML = '<div class="detail-header-wrapper" style="border-bottom:none; margin-bottom:15px;"><div class="detail-header-left"><img src="' + getTagText('Icon') + '" style="filter: grayscale(100%);"><h2 style="margin:0;">' + containerName + ' <span class="badge-deleted">⚠️ This Docker has been DELETED!</span></h2></div></div>';
    newHTML += '<div class="config-restored-alert">✅ Config restored from snapshot: ' + displayDate + '</div>';
    newHTML += '<div class="dd-row dd-status"><span class="dd-label">Status:</span> <span class="dd-value" style="color:#b30000; font-weight:bold;">Offline</span></div>';
    newHTML += '<div class="dd-row dd-repo"><span class="dd-label">Repository:</span> <span class="dd-value">' + getTagText('Repository') + '</span></div>';
    newHTML += '<div class="dd-row dd-network"><span class="dd-label">Network:</span> <span class="dd-value">' + getTagText('Network') + ' (' + getTagText('NetworkType') + ')</span></div>';
    newHTML += '<div class="dd-row dd-webui"><span class="dd-label">Web UI:</span> <span class="dd-value">' + getTagText('WebUI') + '</span></div>';
    newHTML += '<div class="dd-block"><div class="dd-block-label">Overview:</div><pre class="dd-pre" style="white-space: pre-wrap;">' + getTagText('Overview') + '</pre></div>';
    newHTML += '<div class="dd-block"><div class="dd-block-label">Ports:</div><pre class="dd-pre">' + (ports || 'N/A') + '</pre></div>';
    newHTML += '<div class="dd-block"><div class="dd-block-label">Volumes:</div><pre class="dd-pre">' + (vols || 'N/A') + '</pre></div>';
    newHTML += '<div class="dd-block"><div class="dd-block-label">Env Vars:</div><pre class="dd-pre">' + (envs || 'N/A') + '</pre></div>';
    newHTML += '<div class="dd-block" style="margin-top:20px; text-align:right;"><a href="' + pluginDataRoot + '/' + foundSnap + '/xml/' + finalFileName + '" target="_blank" style="font-size:12px; color:#00698c; font-weight:bold; text-decoration:underline;">View Raw XML File</a></div>';
    detailsContainer.innerHTML = newHTML;
}

